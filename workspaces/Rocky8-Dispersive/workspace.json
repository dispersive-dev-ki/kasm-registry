{
  "description": "Rocky Linux 8 Desktop with Dispersive Stealh Networking.",
  "docker_registry": "https://ghcr.io",
  "image_src": "RockyLinux-Dispersive.png",
  "run_config": {
    "hostname": "kasm",
    "cap_add" : ["NET_ADMIN", "NET_RAW"],
    "dns": ["9.9.9.9", "149.112.112.112", "1.1.1.1"]
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop",
    "Network",
    "Security"
  ],
  "friendly_name": "Rocky8-Dispersive",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "ghcr.io/dispersive-dev-ki/kasm-docker-images/rocky8-dispersive-desktop:0.0.1",
      "uncompressed_size_mb": 16107
    },
    {
      "version": "1.18.x",
      "image": "ghcr.io/dispersive-dev-ki/kasm-docker-images/rocky8-dispersive-desktop:0.0.1",
      "uncompressed_size_mb": 16107
    }
  ]
}
