{
  "description": "Rocky Linux 8 with Dispersive Stealh Networking.",
  "docker_registry": "https://dispersive-docker-kasm.jfrog.io",
  "image_src": "RockyLinux-Dispersive.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop",
    "Network",
    "Security"
  ],
  "friendly_name": "Rocky8-Dispersive",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "dispersive-docker-kasm.jfrog.io/rocky8-dispersive-desktop:0.0.1",
      "uncompressed_size_mb": 16107
    }
  ]
}
